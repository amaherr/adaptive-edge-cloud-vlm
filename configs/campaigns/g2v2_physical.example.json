{
  "mode": "physical",
  "grid": "configs/profiles/physical_network_grid_v2.json",
  "cloud_ssh": "REPLACE_USER@REPLACE_CLOUD_LINUX_HOST",
  "cloud_repo": "/REPLACE/absolute/path/to/adaptive-edge-cloud-vlm",
  "cloud_python": "/REPLACE/absolute/path/to/adaptive-edge-cloud-vlm/.venv-model/bin/python",
  "cloud_interface": "eth0",
  "same_device_reference_evidence": {
    "short": "artifacts/g2v2/reference/bundle/index.json",
    "long": "artifacts/g2v2/reference-long/bundle/index.json"
  },
  "output_root": "artifacts/g2v2/physical-unattended",
  "python": ".venv-model/bin/python",
  "test_python": ".venv/bin/python",
  "adaptive_vlm": ".venv-model/bin/adaptive-vlm",
  "artifact_manifest": "configs/model/moondream2_artifact.yaml",
  "cache_dir": ".model-cache",
  "edge_device": "cuda:0",
  "edge_residency": "swap",
  "rate_fallback": false,
  "min_free_gb": 15,
  "stall_seconds": 900,
  "min_host_available_ram_mib": 2048,
  "min_runtime_host_available_ram_mib": 1024,
  "max_restarts_per_subblock": 3,
  "max_subblock_attempts": 2,
  "max_failure_rate": 0.01,
  "edge_dedicated_limit_mib": 3960,
  "spill_margin_mib": 128,
  "require_cloud_wsl_keepalive": true
}
