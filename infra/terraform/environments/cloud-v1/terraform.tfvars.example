# Copy to ignored terraform.tfvars; choose actual verified values.
region = "REQUIRED"
availability_zone = "REQUIRED"
artifact_bucket_name = "REQUIRED-GLOBALLY-UNIQUE"
notification_email = "REQUIRED"
monthly_budget_usd = 0 # REQUIRED: positive user-chosen amount
experiment_max_runtime_hours = 2
edge_instance_type = "g6f.2xlarge" # fallback g4dn.xlarge (protocol A2a-1)
cloud_instance_type = "g6.xlarge"  # g6.2xlarge only if the A2a-2 CPU guard fails
idle_timeout_minutes = 15
edge_ami_id = "REQUIRED-GRID-VERIFIED-AMI"
cloud_ami_id = "REQUIRED-VERIFIED-AMI"
enable_compute = false
launch_approved = false
enable_private_endpoints = false
state_bucket_name = "REQUIRED-BOOTSTRAP-BUCKET"
